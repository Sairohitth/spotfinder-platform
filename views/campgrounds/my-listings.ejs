<% layout('layouts/boilerplate') %>

<h1>My Campgrounds</h1>
<div class="mb-3">
    <a class="btn btn-outline-primary" href="/campgrounds/new">Add Campground</a>
    <a class="btn btn-outline-secondary" href="/campgrounds">All Campgrounds</a>
</div>

<% if(campgrounds.length === 0) { %>
    <div class="alert alert-info" role="alert">
        You have not created any campgrounds yet.
    </div>
<% } else { %>
    <div class="row mb-3">
        <div class="col-md-4 mb-3">
            <div class="border rounded p-3 h-100">
                <div class="text-muted small">Total Campgrounds</div>
                <div class="fs-4 fw-semibold"><%= stats.totalCampgrounds %></div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="border rounded p-3 h-100">
                <div class="text-muted small">Total Reviews</div>
                <div class="fs-4 fw-semibold"><%= stats.totalReviews %></div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="border rounded p-3 h-100">
                <div class="text-muted small">Average Rating</div>
                <div class="fs-4 fw-semibold"><%= stats.averageRating ? `${stats.averageRating} / 5` : 'No reviews yet' %></div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="border rounded p-3 h-100">
                <div class="text-muted small">Average Price</div>
                <div class="fs-4 fw-semibold"><%= stats.averagePrice ? `$${stats.averagePrice} / day` : 'No prices yet' %></div>
            </div>
        </div>
        <div class="col-md-8 mb-3">
            <div class="border rounded p-3 h-100">
                <div class="text-muted small">Highest-Rated Campground</div>
                <% if(stats.highestRatedCampground) { %>
                    <div class="fs-5 fw-semibold"><%= stats.highestRatedCampground.campground.title %></div>
                    <div class="text-muted"><%= stats.highestRatedCampground.averageRating.toFixed(1) %> / 5</div>
                <% } else { %>
                    <div class="fs-5 fw-semibold">No reviews yet</div>
                <% } %>
            </div>
        </div>
    </div>
<% } %>

<% for(let campground of campgrounds) {%>
    <div class="card mb-3">
        <div class="row">
            <div class="col-md-4">
                <img src="<%= campground.images[0].url %>" class="img-fluid" alt="">
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <h5 class="card-title"><%= campground.title %></h5>
                        <span class="fw-semibold text-nowrap">$<%= campground.price %> / day</span>
                    </div>
                    <%- include('../partials/ratingSummary', { campground }) %>
                    <p class="card-text"><%= campground.description %></p>
                    <p class="card-text">
                        <small class="text-muted"><%= campground.location %></small>
                    </p>
                    <a href="/campgrounds/<%= campground._id %>" class="btn btn-primary">View <%= campground.title %></a>
                </div>
            </div>
        </div>
    </div>
<% } %>
