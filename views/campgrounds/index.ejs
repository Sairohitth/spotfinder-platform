<% layout('layouts/boilerplate') %>

<h1>All campgrounds</h1>
<div>
    <a class="btn btn-outline-primary" href="/campgrounds/new">Add Campground</a>
    <a class="btn btn-outline-secondary" href="/campgrounds/my-listings">My Campgrounds</a>
</div>

<form action="/campgrounds" method="GET" class="my-3">
    <div class="input-group">
        <input class="form-control" type="search" name="search" placeholder="Search by title or location"
            value="<%= search %>">
        <select class="form-select" name="sort" aria-label="Sort campgrounds">
            <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest</option>
            <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
            <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
        </select>
        <input class="form-control" type="number" name="minPrice" placeholder="Min price" min="0"
            value="<%= minPrice %>">
        <input class="form-control" type="number" name="maxPrice" placeholder="Max price" min="0"
            value="<%= maxPrice %>">
        <button class="btn btn-primary">Search</button>
        <a class="btn btn-outline-secondary" href="/campgrounds">Clear Filters</a>
    </div>
</form>

<% if(campgrounds.length === 0) { %>
    <div class="alert alert-info" role="alert">
        No campgrounds matched your search. Try a different title or location.
    </div>
<% } %>

<% for(let campground of campgrounds) {%>
    <div class="card mb-3">
        <div class="row">
            <div class="col-md-4">
                <img src="<%= campground.images[0].url %>" class="img-fluid" alt="">
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <h5 class="card-title"><%= campground.title %></h5>
                        <span class="fw-semibold text-nowrap">$<%= campground.price %> / day</span>
                    </div>
                    <%- include('../partials/ratingSummary', { campground }) %>
                    <p class="card-text"><%= campground.description %></p>
                    <p class="card-text">
                        <small class="text-muted"><%= campground.location %></small>
                    </p>
                    <a href="/campgrounds/<%= campground._id %>" class="btn btn-primary">View <%= campground.title %></a>
                </div>
            </div>
        </div>
    </div>
<% } %>

<% if(totalPages > 1) { %>
    <% const paginationParams = new URLSearchParams(); %>
    <% if(search) paginationParams.set('search', search); %>
    <% if(sort && sort !== 'newest') paginationParams.set('sort', sort); %>
    <% if(minPrice) paginationParams.set('minPrice', minPrice); %>
    <% if(maxPrice) paginationParams.set('maxPrice', maxPrice); %>
    <nav aria-label="Campground pages">
        <ul class="pagination justify-content-center">
            <% paginationParams.set('page', currentPage - 1); %>
            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                <a class="page-link" href="/campgrounds?<%= paginationParams.toString() %>">Previous</a>
            </li>
            <% for(let pageNumber = 1; pageNumber <= totalPages; pageNumber++) { %>
                <% paginationParams.set('page', pageNumber); %>
                <li class="page-item <%= currentPage === pageNumber ? 'active' : '' %>">
                    <a class="page-link" href="/campgrounds?<%= paginationParams.toString() %>"><%= pageNumber %></a>
                </li>
            <% } %>
            <% paginationParams.set('page', currentPage + 1); %>
            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="/campgrounds?<%= paginationParams.toString() %>">Next</a>
            </li>
        </ul>
    </nav>
<% } %>
